<?xml version = "1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecowallet.controller.TelaPrincipalController">

    <children>

        <Label layoutX="30.0"
               layoutY="20.0"
               text="EcoWallet" />

        <TextField fx:id="campoDescricao"
                   layoutX="30.0"
                   layoutY="70.0"
                   prefWidth="200.0"
                   promptText="Descrição" />

        <TextField fx:id="campoValor"
                   layoutX="250.0"
                   layoutY="70.0"
                   prefWidth="152.0"
                   promptText="Valor" />

        <ComboBox fx:id="comboCategoria"
                  layoutX="30.0"
                  layoutY="70.0"
                  prefWidth="150.0"
                  promptText="Categoria" />

        <DatePicker fx:id="campoData"
                    layoutX="30.0"
                    layoutY="70.0"
                    prefWidth="150.0" />

        <Button layoutX="30.0"
                layoutY="120.0"
                mnemonicParsing="false"
                text="Adicionar Receita" 
                onAction="#adicionarReceita"/>

        <Button layoutX="200.0"
                layoutY="120.0"
                mnemonicParsing="false"
                text="Adicionar Despesa" 
                onAction="#adicionarDespesa"/>
                
        <Label fx:id="labelSaldo"
               layoutX="600.0"
               layoutY="125.0"
               text="Saldo = R$ 0,00" />

        <TableView fx:id="TableTransacoes"
                   layoutX="30.0"
                   layoutY="180.0"
                   prefHeight="350.0"
                   prefWidth="740.0">

            <columns>

                <TableColumn prefWidth="200.0"
                             text="Descrição" />

                <TableColumn prefWidth="120.0"
                             text="Valor" />

                <TableColumn prefWidth="150.0"
                             text="Categoria" />

                <TableColumn prefWidth="150.0"
                             text="Data" />

                <TableColumn prefWidth="120.0"
                             text="Tipo" />

            </columns>

        </TableView>

    </children>

</AnchorPane>