<?xml version = "1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecowallet.controller.TelaPrincipalController">

    <children>

       <Label layoutX="30.0"
       layoutY="20.0"
       style="-fx-font-size: 24px; -fx-font-weight: bold;"
       text="EcoWallet" />

<Label layoutX="30.0"
       layoutY="60.0"
       text="Descrição" />

<Label layoutX="250.0"
       layoutY="60.0"
       text="Valor" />

<Label layoutX="390.0"
       layoutY="60.0"
       text="Tipo" />

<Label layoutX="530.0"
       layoutY="60.0"
       text="Categoria" />

<Label layoutX="690.0"
       layoutY="60.0"
       text="Data" />

<TextField fx:id="campoDescricao"
           layoutX="30.0"
           layoutY="85.0"
           prefWidth="180.0" />

<TextField fx:id="campoValor"
           layoutX="230.0"
           layoutY="85.0"
           prefWidth="120.0" />

<ComboBox fx:id="comboTipo"
          layoutX="370.0"
          layoutY="85.0"
          prefWidth="140.0" />

<ComboBox fx:id="comboCategoria"
          layoutX="530.0"
          layoutY="85.0"
          prefWidth="140.0" />

<DatePicker fx:id="campoData"
            layoutX="690.0"
            layoutY="85.0"
            prefWidth="100.0" />

<Button layoutX="30.0"
        layoutY="140.0"
        mnemonicParsing="false"
        text="Adicionar Receita"
        onAction="#adicionarReceita"/>

<Button layoutX="200.0"
        layoutY="140.0"
        mnemonicParsing="false"
        text="Adicionar Despesa"
        onAction="#adicionarDespesa"/>

<Label fx:id="labelSaldo"
       layoutX="30.0"
       layoutY="200.0"
       style="-fx-font-size: 20px; -fx-font-weight: bold;"
       text="Saldo Total: R$ 0,00"/>

<TableView fx:id="tableTransacoes"
           layoutX="30.0"
           layoutY="250.0"
           prefHeight="300.0"
           prefWidth="740.0">

    <columns>

       <TableColumn fx:id="colDescricao"
             prefWidth="200.0"
             text="Descrição" />

<TableColumn fx:id="colValor"
             prefWidth="120.0"
             text="Valor (R$)" />

<TableColumn fx:id="colCategoria"
             prefWidth="150.0"
             text="Categoria" />

<TableColumn fx:id="colData"
             prefWidth="150.0"
             text="Data" />

<TableColumn fx:id="colTipo"
             prefWidth="120.0"
             text="Tipo" />

           </columns>

      </TableView>

    </children>

</AnchorPane>